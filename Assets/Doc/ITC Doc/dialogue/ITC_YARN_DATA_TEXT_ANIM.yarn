title: C2_D146
---
<<itc_bg window13>>
<<if $Route_CurrentClient == 1>>
    <<if $Route_StampType != "事件">>
        <<set $Sign_mistake = 1>>
        <<set $satisfaction = $satisfaction - 1>>
        Narrator: |typewriter|<shake a=0.45>印章选择错误</shake>。<waitfor=0.12>本客户应选择事件类印章。
    <<else>>
        Narrator: |typewriter|<wave s=0.7>印章选择正确</wave>。
    <<endif>>
    <<jump ITC_Client1_SoulInput>>
<<else>>
    <<if $Route_CurrentClient == 2>>
        <<if $Route_StampType != "特技">>
            <<set $Sign_mistake = 1>>
            <<set $satisfaction = $satisfaction - 1>>
            Narrator: |typewriter|<shake a=0.45>印章选择错误</shake>。<waitfor=0.12>本客户应选择特技类印章。
        <<else>>
            Narrator: |typewriter|<wave s=0.7>印章选择正确</wave>。
        <<endif>>
        <<jump ITC_Client2_SoulInput>>
    <<else>>
        Narrator: |typewriter|<wiggle s=0.7>未识别的客户路由</wiggle>。
        <<jump ITC_Act4_EndingEntry>>
    <<endif>>
<<endif>>
===

title: C2_D155
---
<<itc_bg window13>>
<<if $Route_QTEErrorCount >= 3>>
    <<set $Sign_mistake = 1>>
    Narrator: |typewriter|<shake a=0.55>打字机环节严重失误，<waitfor=0.12>签约判定失败。</shake>
<<else>>
    <<if $Route_QTEErrorCount == 2>>
        <<set $satisfaction = $satisfaction - 1>>
        Narrator: |typewriter|打字机环节二次失误，<waitfor=0.12>客户满意度下降。
    <<endif>>
<<endif>>
<<if $Route_CurrentClient == 1>>
    <<itc_rune_verify 1>>
    <<jump ITC_Client1_StampInput>>
<<else>>
    <<if $Route_CurrentClient == 2>>
        <<itc_rune_verify 2>>
        <<jump ITC_Client2_StampInput>>
    <<else>>
        <<jump ITC_Act4_EndingEntry>>
    <<endif>>
<<endif>>
===

title: C3_D176
---
<<itc_bg window13>>
<<if $Route_SoulCollectPercent < $Route_SoulMin>>
    <<set $Sign_mistake = 1>>
    Narrator: |typewriter|<shake a=0.55>灵魂收取过少，<waitfor=0.12>签约判定失败。</shake>
<<else>>
    <<if $Route_SoulCollectPercent > $Route_SoulMax>>
        <<set $satisfaction = $satisfaction - 1>>
        Narrator: |typewriter|灵魂收取过多，<waitfor=0.12>客户满意度下降。
    <<else>>
        Narrator: |typewriter|<wave s=0.7>灵魂收取比例正确</wave>。
    <<endif>>
<<endif>>
<<if $Route_CurrentClient == 1>>
    <<jump ITC_Client1_PostContract>>
<<else>>
    <<if $Route_CurrentClient == 2>>
        <<jump ITC_Client2_PostContract>>
    <<else>>
        <<jump ITC_Act4_EndingEntry>>
    <<endif>>
<<endif>>
===

title: C3_D252
---
<<itc_bg henet_office>>
<<if $Sign_mistake == 1>>
    <<set $Nmber_of_sign_mistake = $Nmber_of_sign_mistake + 1>>
    <<set $Global_sign_mistake = $Global_sign_mistake + 1>>
<<endif>>
<<if $Route_CurrentClient == 1>>
    <<if $Sign_mistake == 1>>
        Henet: |fade|<incr>蠢货</incr>。<waitfor=0.18>你刚刚那次签约失误我已经看到了。<waitfor=0.24>再来两次，你就滚出 ITC。
    <<else>>
        <<if $satisfaction >= 3>>
            Henet: |fade|不错。<waitfor=0.12>你的第一份契约处理得还算顺利。<waitfor=0.18>继续保持。
        <<else>>
            Henet: |fade|契约算是完成了，<waitfor=0.12>但你的服务质量远不够看。
        <<endif>>
    <<endif>>
    <<jump ITC_Client2_Thomas_Intro>>
<<else>>
    <<if $Route_CurrentClient == 2>>
        <<if $Sign_mistake == 1>>
            Henet: |fade|第二份契约出现失误。<waitfor=0.18>记住，你的试工名额不是无限的。
        <<else>>
            <<if $satisfaction >= 3>>
                Henet: |fade|这份契约处理得不错。<waitfor=0.18>继续工作。
            <<else>>
                Henet: |fade|勉强合格。<waitfor=0.12>别让低满意度成为常态。
            <<endif>>
        <<endif>>
        <<jump ITC_Day1_MoreClients>>
    <<else>>
        <<jump ITC_Act4_EndingEntry>>
    <<endif>>
<<endif>>
===

title: ITC_Act4_EndingEntry
---
<<itc_bg itc_office>>
<<itc_npc_main_hide>>
<<itc_npc_avatar_hide>>
Narrator: |typewriter|结局判定中。<waitfor=0.18>累计签约失误 {$Nmber_of_sign_mistake}，<waitfor=0.12>当前 DAY {$DAY}。
<<if $Nmber_of_sign_mistake >= 3>>
    <<jump ITC_Ending_Fired>>
<<else>>
    <<if $DAY >= 13>>
        <<jump ITC_Ending_TrialComplete>>
    <<else>>
        <<if $HiddenEndingTrigger>>
            <<jump ITC_Ending_Hidden>>
        <<else>>
            <<jump ITC_Act5_AfterWork>>
        <<endif>>
    <<endif>>
<<endif>>
===

title: ITC_Ending_Fired
---
